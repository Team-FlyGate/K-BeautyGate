# cp .env.example .env 후 값을 채우세요. .env는 git에 올라가지 않습니다.
# 키가 없으면 규칙 기반으로만 동작합니다(요약·코스 문장 생성은 건너뜀).
NVIDIA_API_KEY=

# 판단·추천·카드 작성 (Nemotron 3 Ultra, 한·영·중·일)
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_CHAT_URL=https://integrate.api.nvidia.com/v1/chat/completions

# 선택: 리랭커 (계정 접근이 확인되면 사용, 실패하면 자동으로 건너뜀)
RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2
NVIDIA_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-1b-v2/reranking

NVIDIA_TIMEOUT=60
