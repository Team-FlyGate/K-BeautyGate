# cp .env.example .env 후 값을 채우세요. .env는 git에 올라가지 않습니다.
# 키가 없으면 규칙 기반으로만 동작합니다(요약·코스 문장 생성은 건너뜀).
NVIDIA_API_KEY=

# 판단·추천·카드 작성 (Nemotron 3 Ultra, 한·영·중·일)
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_CHAT_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Ultra가 503이면 차례로 시도할 모델 (쉼표 구분)
NEMOTRON_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b

# 다국어 질문 ↔ 자료 관련도 (Nemotron 3 Embed)
EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBED_URL=https://integrate.api.nvidia.com/v1/embeddings

NVIDIA_TIMEOUT=90
